#: random.cpp:48
#, kde-format
msgid ""
"Usage: %1 [-setup] [args]\n"
"Starts a random screen saver.\n"
"Any arguments (except -setup) are passed on to the screen saver."
msgstr ""
"उपयोग: %1 [-setup] [args]\n"
"बेतरतीब स्क्रीन सेवर प्रारंभ करैत अछि.\n"
"कोनो आर्गुमेंट( -setup केर अलावा) केँ स्क्रीन सेवर पर पास कए देल जाएत अछि."

#: random.cpp:55
#, kde-format
msgid "Start a random KDE screen saver"
msgstr "बेतरतीब केडीई स्क्रीन सेवर प्रारंभ करैत अछि"

#: random.cpp:70
#, kde-format
msgid "Random screen saver"
msgstr "बेतरतीब स्क्रीन सेवर"

#: random.cpp:76
#, kde-format
msgid "Setup screen saver"
msgstr "स्क्रीन सेवर सेटअप करू"

#: random.cpp:78
#, kde-format
msgid "Run in the specified XWindow"
msgstr "निर्दिष्ट एक्स-विंडोमे चलाबू"

#: random.cpp:80
#, kde-format
msgid "Run in the root XWindow"
msgstr "रूट एक्स-विंडोमे चलाबू"

#: random.cpp:194
#, kde-format
msgid "Setup Random Screen Saver"
msgstr "बेतरतीब स्क्रीन सेवर सेटअप करू"

#: random.cpp:202
#, kde-format
msgid "Use OpenGL screen savers"
msgstr "ओपन जीएल स्क्रीन सेवर्स इस्तेमाल करू"

#: random.cpp:205
#, kde-format
msgid "Use screen savers that manipulate the screen"
msgstr "स्क्रीन सेवर्स इस्तेमाल करू जे स्क्रीनमे हेरफेर करैत अछि"

#: kio_floppy.cpp:198
#, kde-format
msgid ""
"Could not access drive %1.\n"
"The drive is still busy.\n"
"Wait until it is inactive and then try again."
msgstr ""
"ड्राइव %1 पर पहुँच नहि सकल.\n"
"ड्राइव अखनो व्यस्त अछि.\n"
"एकर काज पूरा हाएत तक इंतजार करू तथा फिनु सँ  कोसिस करू. "

#: kio_floppy.cpp:202 kio_floppy.cpp:1116
#, kde-format
msgid ""
"Could not write to file %1.\n"
"The disk in drive %2 is probably full."
msgstr ""
"फाइल %1 पर लिखि नहि सकल.\n"
"ड्राइवमे डिस्क %2 संभवत: पूरा भरि गेल अछि"

#: kio_floppy.cpp:212
#, kde-format
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2"
msgstr ""
"%1 पर पहुँच नहि सकल.\n"
"संभवतः ड्राइव %2 मे कोनो डिस्क नहि अछि"

#: kio_floppy.cpp:216
#, kde-format
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2 or you do not have enough "
"permissions to access the drive."
msgstr ""
"%1 पर पहुँच नहि सकल.\n"
"संभवतः ड्राइव %2 मे कोनो डिस्क नहि अछि अथवा अहाँक पास उक्त ड्राइवमे पहुँच केर पर्याप्त "
"अनुमति नहि अछि."

#: kio_floppy.cpp:220
#, kde-format
msgid ""
"Could not access %1.\n"
"The drive %2 is not supported."
msgstr ""
"%1 पर पहुँच नहि सकल.\n"
"संभवतः ड्राइव %2 समर्थित नहि अछि."

#: kio_floppy.cpp:225
#, kde-format
msgid ""
"Could not access %1.\n"
"Make sure the floppy in drive %2 is a DOS-formatted floppy disk \n"
"and that the permissions of the device file (e.g. /dev/fd0) are set "
"correctly (e.g. rwxrwxrwx)."
msgstr ""
"%1 पर पहुँच नहि सकल.\n"
"कृप्या सुनिश्चित होउ जे ड्राइव %2 केर फ्लापी एकटा डास फार्मेटेड फ्लापी डिस्क अछि \n"
"तथा अओजार फाइल (जहिना जे /dev/fd0) केर अनुमति उचित प्रकार नियत अछि (जहिना जे- "
"rwxrwxrwx)."

#: kio_floppy.cpp:229
#, kde-format
msgid ""
"Could not access %1.\n"
"The disk in drive %2 is probably not a DOS-formatted floppy disk."
msgstr ""
"फाइल %1 पर लिखि नहि सकल.\n"
"ड्राइवमे डिस्क %2 संभवत: डास फार्मेटेड फ्लापी डिस्क नहि अछि."

#: kio_floppy.cpp:233
#, kde-format
msgid ""
"Access denied.\n"
"Could not write to %1.\n"
"The disk in drive %2 is probably write-protected."
msgstr ""
"पहुँच अस्वीकृत.\n"
"%1 पर लिखि नहि सकल.\n"
"संभवतः ड्राइव %2 मे लिखब सँ रोक लागल अछि."

#: kio_floppy.cpp:242
#, kde-format
msgid ""
"Could not read boot sector for %1.\n"
"There is probably not any disk in drive %2."
msgstr ""
" %1 क' बूट सेक्टर पढि नहि सकल.\n"
"संभवतः ड्राइव %2 मे कोनो डिस्क नहि अछि."

#: kio_floppy.cpp:365
#, kde-format
msgid ""
"Could not start program \"%1\".\n"
"Ensure that the mtools package is installed correctly on your system."
msgstr ""
"प्रोग्राम \"%1\" केँ प्रारंभ नहि कए सकल.\n"
"सुनिश्चित करू जे एमटूल पैकेज अहाँक तंत्र पर उचित प्रकार सँस्थापित अछि."

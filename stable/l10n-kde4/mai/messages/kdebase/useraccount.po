#: main.cpp:106
msgid ""
"<qt>Here you can change your personal information, which will be used, for "
"instance, in mail programs and word processors. You can change your login "
"password by clicking <em>Change Password...</em>.</qt>"
msgstr ""

#: main.cpp:120
msgid ""
"A program error occurred: the internal program 'kdepasswd' could not be "
"found. You will not be able to change your password."
msgstr ""

#: main.cpp:213
msgid "Please enter your password in order to save your settings:"
msgstr "अपन विन्यासकेँ सहेजबाक लेल कृप्या अपन पासवर्ड भरू:"

#: main.cpp:216
msgid "You must enter your password in order to change your information."
msgstr "अपन जानकारसभकेँ बदलबाक लेल अहाँक अपन पासवर्ड भरनाइ आवश्यक अछि."

#: main.cpp:226
msgid "You must enter a correct password."
msgstr "अहाँक एकटा सही पासवर्ड भरनाइ हाएत."

#: main.cpp:230
#, kde-format
msgid ""
"An error occurred and your password has probably not been changed. The error "
"message was:\n"
"%1"
msgstr ""
"एकटा त्रुटि भेल तथा अहाँक पासवर्ड संभवत: बदलल नहि गेल. त्रुटि संदेश छल:\n"
"%1"

#: main.cpp:249
#, kde-format
msgid "There was an error saving the image: %1"
msgstr "छवि: %1 सहेजबामे त्रुटि भेल"

#: main.cpp:282 main.cpp:316
msgid "Your administrator has disallowed changing your image."
msgstr "अहाँक प्रशासक ने अहाँक छविकेँ बदलबाकअनुमति नहि देने अछि."

#: main.cpp:349
#, kde-format
msgid ""
"%1 does not appear to be an image file.\n"
"Please use files with these extensions:\n"
"%2"
msgstr ""
"%1 छवि फाइल जहिना प्रतीत नहि हाएत अछि.\n"
"कृप्या फाइलसभ जे एहि एक्सटेंशन केर सँग हुए केर उपयोग करू:\n"
"%2"


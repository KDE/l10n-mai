#: main.cpp:52
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"विश्वसनीय सत्र प्रबंधक जे मानक X11R6 सँ वार्तालाप करैत अछि \n"
"सत्र प्रबंधक प्रोटोकाल (XSMP)."

#: main.cpp:244
msgid "The KDE Session Manager"
msgstr "केडीई सत्र प्रबंधक"

#: main.cpp:246
msgid "(C) 2000, The KDE Developers"
msgstr "(C) 2000, The KDE Developers"

#: main.cpp:247
msgid "Matthias Ettrich"
msgstr "मेथियास एट्रिच"

#: main.cpp:248
msgid "Luboš Luňák"
msgstr "Luboš Luňák"

#: main.cpp:248
msgid "Maintainer"
msgstr "अनुरक्षक"

#: main.cpp:256
msgid "Restores the saved user session if available"
msgstr " जँ उपलब्ध अछि तँ सहेजल गेल प्रयोक्ता सत्र बहाल करू"

#: main.cpp:258
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"प्रारंभ करैत अछि 'wm' जँ कोनो आन विंडो प्रबंधक उपलब्ध नहि अछि\n"
"सत्र मे. पूर्वनिर्धारित अछि 'kwin'"

#: main.cpp:259
msgid "Also allow remote connections"
msgstr "रिमोटो कनेक्शन स्वीकारू"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "संगीता कुमारी"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "sangeeta09@gmail.com"


msgstr "कोनो मेल खाता पैटर्न '%1' विंडो आओर कमांड उल्लेखित नहि.\n"

#: ksystraycmd.cpp:87
#, kde-format
msgid "KSysTrayCmd: K3ShellProcess cannot find a shell."
msgstr "KSysTrayCmd: K3ShellProcess केँ कोनो शैल नहि भेटल."


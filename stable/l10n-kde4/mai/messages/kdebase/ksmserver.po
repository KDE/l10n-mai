msgstr "कम्प्यूटर बन्न करू (&T)"

#: shutdowndlg.cpp:423
msgid "&Standby"
msgstr "स्टैंडबाय (&S)"

#: shutdowndlg.cpp:427
msgid "Suspend to &RAM"
msgstr "रैम मे सस्पेंड करू (&R)"

#: shutdowndlg.cpp:431

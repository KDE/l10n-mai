#: main.cpp:46
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr "KIO Exec - रिमोट फाइल खोलैत अछि. परिवर्धन पर निगाह राखैत अछि. अपलोड क' लेल पूछैत अछि"

#: main.cpp:54
msgid "'command' expected.\n"
msgstr "'कमांड' प्रत्याशित.\n"

#: main.cpp:83
#, kde-format
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"यूआरएल %1\n"
"गलत विरूपित अछि "

#: main.cpp:85
#, kde-format
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"रिमोट यूआरएल %1\n"
" --tempfiles स्विच क' सँग स्वीकार्य नहि"

#: main.cpp:218
#, kde-format
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"अस्थायी फाइल मानल गेल फाइल\n"
"%1\n"
"परिवर्धित कएल गेल.\n"
"की अहाँ एकरा आबो मेटाबैक लेल चाहैत छी?"

#: main.cpp:219 main.cpp:226
msgid "File Changed"
msgstr "फाइल परिवर्तित"

#: main.cpp:219
msgid "Do Not Delete"
msgstr "मेटाउ नहि"

#: main.cpp:225
#, kde-format
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"फाइल\n"
"%1\n"
"परिवर्धित कएल जाए चुकल अछि.\n"
" की अहाँ परिवर्तन केँ अपलोड कएनाइ चाहब?"

#: main.cpp:226
msgid "Upload"
msgstr "अपलोड"

#: main.cpp:226
msgid "Do Not Upload"
msgstr "अपलोड नहि करू"


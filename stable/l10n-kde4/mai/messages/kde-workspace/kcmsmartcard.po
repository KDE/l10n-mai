#: smartcard.cpp:395
#, kde-format
msgid ""
"<h1>smartcard</h1> This module allows you to configure KDE support for "
"smartcards. These can be used for various tasks such as storing SSL "
"certificates and logging in to the system."
msgstr ""

#. i18n: ectx: attribute (title), widget (QWidget)
#: smartcardbase.ui:31
#, kde-format
msgid "Smartcard Support"
msgstr "स्मार्ट-कार्ड समर्थन"

#. i18n: ectx: property (text), widget (QCheckBox)
#: smartcardbase.ui:42
#, kde-format
msgid "&Enable smartcard support"
msgstr "स्मार्ट-कार्ड समर्थन सक्षम करू (&E)"

#. i18n: ectx: property (text), widget (QCheckBox)
#: smartcardbase.ui:61
#, kde-format
msgid "Enable &polling to autodetect card events"
msgstr "कार्ड घटनासभ केँ स्वचलित पता लगाबै क' लेल पोलिंग सक्षम करू. (&p)"

#. i18n: ectx: property (whatsThis), widget (QCheckBox)
#: smartcardbase.ui:64
#, kde-format
msgid ""
"In most cases you should have this enabled. It allows KDE to automatically "
"detect card insertion and reader hotplug events."
msgstr ""
"प्रायः सबहि दशा मे अहाँक एकरा सक्षम कएक रखबा पड़त. ई केडीई केँ कार्ड इंसर्शन तथा रीडर "
"हाटप्लग घटनासँ स्वचलित पता लगाबै देत अछि."

#. i18n: ectx: property (text), widget (QCheckBox)
#: smartcardbase.ui:92
#, kde-format
msgid "Automatically &launch card manager if inserted card is unclaimed"
msgstr ""
"जँ प्रविष्ट कएल गेल कार्ड दावा रहित रहैत अछि तँ कार्ड प्रबंधक स्वचलित प्रारंभ करू (&l)"

#. i18n: ectx: property (whatsThis), widget (QCheckBox)
#: smartcardbase.ui:95
#, kde-format
msgid ""
"When you insert a smartcard, KDE can automatically launch a management tool "
"if no other application attempts to use the card."
msgstr ""

#. i18n: ectx: property (text), widget (QCheckBox)
#: smartcardbase.ui:106
#, kde-format
msgid "&Beep on card insert and removal"
msgstr "कार्ड प्रविष्ट पर तथा निकास पर बीप करू (&B)"


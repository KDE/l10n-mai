"\n"

#: kioclient.cpp:89
#, kde-format
msgid ""
"  kioclient cat 'url'\n"
"            # Writes out the contents of 'url' to stdout\n"
"\n"
msgstr ""
"  kioclient cat 'url'\n"
"            # Writes out the contents of 'url' to stdout\n"
"\n"

#: kioclient.cpp:91
#, fuzzy, kde-format
#| msgid ""
#| "  kioclient cat 'url'\n"
#| "            # Writes out the contents of 'url' to stdout\n"
#| "\n"

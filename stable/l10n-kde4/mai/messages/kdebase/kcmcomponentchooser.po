msgstr "केडीइ डेस्कटाप क' लेल के-मेल एकटा मानक मेल प्रोग्राम अछि."

#. i18n: file: emailclientconfig_ui.ui:123
#. i18n: ectx: property (text), widget (QRadioButton, kmailCB)
#: rc.cpp:56
msgid "&Use KMail as preferred email client"
msgstr "के-मेल केँ मनपसिन्न क्लाइंटक रूपेँ इस्तेमाल करू (&U)"

#. i18n: file: emailclientconfig_ui.ui:130
#. i18n: ectx: property (whatsThis), widget (QRadioButton, otherCB)
#: rc.cpp:59
msgid "Select this option if you want to use any other mail program."
msgstr "जँ अहाँ आन मेल प्रोग्राम क' उपयोग कएनाइ चाहैत छी तँ एहि विकल्प केँ चुनू."

#. i18n: file: emailclientconfig_ui.ui:133
#. i18n: ectx: property (text), widget (QRadioButton, otherCB)
#: rc.cpp:62
msgid "Use a different &email client:"
msgstr "एकटा भिन्न क्लाएंटक इस्तेमाल करू: (&e)"


#: kio_sftp.cpp:432
msgid "An internal error occurred. Please retry the request again."
msgstr "एकटा आंतरिक त्रुटि भेल. कृपया फेर सँ निवेदन करू ."

#: kio_sftp.cpp:514
#, kde-format
msgid "Opening SFTP connection to host %1:%2"
msgstr ""

#: kio_sftp.cpp:518
msgid "No hostname specified"
msgstr "कोनो होस्टनाम उल्लेखित नहि अछि."

#: kio_sftp.cpp:529
msgid "SFTP Login"
msgstr "एसएफटीपी लागइन"

#: kio_sftp.cpp:531
msgid "site:"
msgstr "साइटः"

#: kio_sftp.cpp:631
msgid "Please enter your username and key passphrase."
msgstr "कृपया अपन प्रयोक्ता-नाम तथा कुँजी कूटशब्द भरू"

#: kio_sftp.cpp:633
msgid "Please enter your username and password."
msgstr "कृपया अपन प्रयोक्ता-नाम तथा कूटशब्द भरू."

#: kio_sftp.cpp:641
msgid "Incorrect username or password"
msgstr "गलत प्रयोक्ता-नाम अथवा कूटशब्द"

#: kio_sftp.cpp:698
msgid "Warning: Cannot verify host's identity."
msgstr "चेतावनीः होस्ट क' परिचय सत्यापित नहि कए सकल."

#: kio_sftp.cpp:709
msgid "Warning: Host's identity changed."
msgstr "चेतावनीः होस्ट क' परिचय परिवर्तित कएल गेल अछि."

#: kio_sftp.cpp:720 kio_sftp.cpp:721
msgid "Authentication failed."
msgstr "सत्यापन असफल"

#: kio_sftp.cpp:735 kio_sftp.cpp:753
msgid "Connection failed."
msgstr "संबंधन विफल भ' गेल"

#: kio_sftp.cpp:736 ksshprocess.cpp:833 ksshprocess.cpp:977
msgid "Connection closed by remote host."
msgstr "रिमोट होस्ट द्वारा कनेक्शन बन्न कएल गेल."

#: kio_sftp.cpp:755
#, kde-format
msgid "unexpected SFTP error: %1"
msgstr "अप्रत्याशित SFTP त्रुटि: %1"

#: kio_sftp.cpp:802
#, kde-format
msgid "SFTP version %1"
msgstr "एसएफटीपी संस्करण %1"

#: kio_sftp.cpp:808
msgid "Protocol error."
msgstr "प्रोटोकाल त्रुटि."

#: kio_sftp.cpp:814
#, kde-format
msgid "Successfully connected to %1"
msgstr "%1 सँ सफलता पूर्वक जुड़ल"

#: kio_sftp.cpp:1172
msgid "An internal error occurred. Please try again."
msgstr "आंतरिक त्रुटि भेल. कृपया फेर कोशिश करू."

#: kio_sftp.cpp:1193
#, kde-format
msgid ""
"Unknown error was encountered while copying the file to '%1'. Please try "
"again."
msgstr "फाइल केँ '%1' पर नक़ल करब क' दौरान अज्ञात त्रुटि भेल. कृपया फेर कोशिश करू."

#: kio_sftp.cpp:1411
msgid "The remote host does not support renaming files."
msgstr "रिमोट होस्ट फाइल नाम बदलनाइ समर्थित नहि करैत."

#: kio_sftp.cpp:1460
msgid "The remote host does not support creating symbolic links."
msgstr "रिमोट होस्ट सिंबालिक लिंक्स तैआर करब क' लेल समर्थन नहि करैत अछि."

#: kio_sftp.cpp:1594
msgid "Connection closed"
msgstr "कनेक्शन बन्न"

#: kio_sftp.cpp:1596
msgid "Could not read SFTP packet"
msgstr "एसएफटीपी पैकेट पढ़ि नहि सकल"

#: kio_sftp.cpp:1708
msgid "End of file."
msgstr "फाइलक अंत"

#: kio_sftp.cpp:1717
msgid "SFTP command failed for an unknown reason."
msgstr "अज्ञात कारणसँ एसएफटीपी कमांड असफल."

#: kio_sftp.cpp:1721
msgid "The SFTP server received a bad message."
msgstr "एसएफटीपी सर्वर केँ खराब संदेश प्राप्त."

#: kio_sftp.cpp:1725
msgid "You attempted an operation unsupported by the SFTP server."
msgstr "अहाँक द्वारा एसएफटीपी सर्वर द्वारा असमर्थित आपरेशन चाहल गेल."

#: kio_sftp.cpp:1729
#, kde-format
msgid "Error code: %1"
msgstr "त्रुटि कोडः %1"

#: ksshprocess.cpp:449
msgid "Cannot specify a subsystem and command at the same time."
msgstr "ओहए समय पर एकटा उप-तंत्र तथा कमांड उल्लेखित नहि कए सकैत अछि."

#: ksshprocess.cpp:770
msgid "No options provided for ssh execution."
msgstr "एसएसएच चलाबै क' लेल कोनो विकल्प नहि देल गेल अछि."

#: ksshprocess.cpp:777
msgid "Failed to execute ssh process."
msgstr "एसएसएच प्रक्रिया केँ चलाबैमे असफल."

#: ksshprocess.cpp:801 ksshprocess.cpp:828 ksshprocess.cpp:944
#: ksshprocess.cpp:1015
msgid "Error encountered while talking to ssh."
msgstr "एसएसएच सँ बात करबा मे त्रुटि भेल."

#: ksshprocess.cpp:878
msgid "Please supply a password."
msgstr "कृपया कूटशब्द भरू."

#: ksshprocess.cpp:916
msgid "Please supply the passphrase for your SSH private key."
msgstr "कृपया अपन एसएसएच निज कुँजी क' लेल कूटशब्द दिअ'."

#: ksshprocess.cpp:930
#, kde-format
msgid "Authentication to %1 failed"
msgstr "%1 सँ प्रमाणीकरण मे असफल"

#: ksshprocess.cpp:952
#, kde-format
msgid ""
"The identity of the remote host '%1' could not be verified because the "
"host's key is not in the \"known hosts\" file."
msgstr ""
"रिमोट होस्ट '%1' केँ पहचान सत्यापित नहि कएल जाए सकल किएक' होस्ट कुँजी \"जानल मेजबान"
"\" फाइल मे नहि अछि."

#: ksshprocess.cpp:958
msgid ""
" Manually, add the host's key to the \"known hosts\" file or contact your "
"administrator."
msgstr "होस्ट कुँजी हाथेसँ \"जानल मेजबान\" फाइल मे जोड़ू अथवा अपन तंत्र प्रशासक सँ संपर्क करू."

#: ksshprocess.cpp:964
#, kde-format
msgid " Manually, add the host's key to %1 or contact your administrator."
msgstr "होस्ट कुँजी हाथे सँ %1 मे जोड़ू अथवा अपन तंत्र प्रशासक सँ संपर्क करू."

#: ksshprocess.cpp:996
#, kde-format
msgid ""
"The identity of the remote host '%1' could not be verified. The host's key "
"fingerprint is:\n"
"%2\n"
"You should verify the fingerprint with the host's administrator before "
"connecting.\n"
"\n"
"Would you like to accept the host's key and connect anyway? "
msgstr ""

#: ksshprocess.cpp:1023
#, kde-format
msgid ""
"WARNING: The identity of the remote host '%1' has changed!\n"
"\n"
"Someone could be eavesdropping on your connection, or the administrator may "
"have just changed the host's key. Either way, you should verify the host's "
"key fingerprint with the host's administrator. The key fingerprint is:\n"
"%2\n"
"Add the correct host key to \"%3\" to get rid of this message."
msgstr ""

#: ksshprocess.cpp:1058
#, kde-format
msgid ""
"WARNING: The identity of the remote host '%1' has changed!\n"
"\n"
"Someone could be eavesdropping on your connection, or the administrator may "
"have just changed the host's key. Either way, you should verify the host's "
"key fingerprint with the host's administrator before connecting. The key "
"fingerprint is:\n"
"%2\n"
"\n"
"Would you like to accept the host's new key and connect anyway?"
msgstr ""

#: ksshprocess.cpp:1080
msgid "Host key was rejected."
msgstr "होस्ट कुँजी अस्वीकृत छल."

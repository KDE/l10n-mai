#: autobookmarker/autobookmarker.cpp:92
msgid "AutoBookmarks"
msgstr "स्वचालित-पुस्तचिन्ह"

#: autobookmarker/autobookmarker.cpp:103
msgid "Configure AutoBookmarks"
msgstr "स्वचालित-पुस्तचिन्ह बिन्यस्त करू"

#: autobookmarker/autobookmarker.cpp:280
msgid "Edit Entry"
msgstr "प्रविष्टि संपादित करू"

#: autobookmarker/autobookmarker.cpp:288
msgid "&Pattern:"
msgstr "प्रारूप: (&P)"

#: autobookmarker/autobookmarker.cpp:294
msgid "<p>A regular expression. Matching lines will be bookmarked.</p>"
msgstr "<p>एकटा रेगुलर एक्सप्रेशन. जोड़ भेटैत पंक्तिसभकेँ पुस्तचिह्नित कएल जाएत.</p>"

#: autobookmarker/autobookmarker.cpp:298
msgid "Case &sensitive"
msgstr "केस सेंसिटिव (&s)"

#: autobookmarker/autobookmarker.cpp:302
msgid ""
"<p>If enabled, the pattern matching will be case sensitive, otherwise not.</"
"p>"
msgstr "<p>जँ सक्षम कएल जाइछ. पैटर्न जोड़ मिलैनाइ केस सेंसिटिव हाएत, आन रूपेँ नहि.</p>"

#: autobookmarker/autobookmarker.cpp:305
msgid "&Minimal matching"
msgstr "न्यूनतम जोड़ मिलाबू (&M)"

#: autobookmarker/autobookmarker.cpp:309
msgid ""
"<p>If enabled, the pattern matching will use minimal matching; if you do not "
"know what that is, please read the appendix on regular expressions in the "
"kate manual.</p>"
msgstr ""

#: autobookmarker/autobookmarker.cpp:313
msgid "&File mask:"
msgstr "फाइल मास्क: (&F)"

#: autobookmarker/autobookmarker.cpp:319
msgid ""
"<p>A list of filename masks, separated by semicolons. This can be used to "
"limit the usage of this entity to files with matching names.</p><p>Use the "
"wizard button to the right of the mimetype entry below to easily fill out "
"both lists.</p>"
msgstr ""

#: autobookmarker/autobookmarker.cpp:324
msgid "MIME &types:"
msgstr "माइम प्रकार: (&t)"

#: autobookmarker/autobookmarker.cpp:330
msgid ""
"<p>A list of mime types, separated by semicolon. This can be used to limit "
"the usage of this entity to files with matching mime types.</p><p>Use the "
"wizard button on the right to get a list of existing file types to choose "
"from, using it will fill in the file masks as well.</p>"
msgstr ""

#: autobookmarker/autobookmarker.cpp:340
msgid ""
"<p>Click this button to display a checkable list of mimetypes available on "
"your system. When used, the file masks entry above will be filled in with "
"the corresponding masks.</p>"
msgstr ""

#: autobookmarker/autobookmarker.cpp:365
msgid ""
"Select the MimeTypes for this pattern.\n"
"Please note that this will automatically edit the associated file extensions "
"as well."
msgstr ""
"ई पैटर्न क' लेल माइम प्रकार चुनू.\n"
"कृप्या टीप लिअ' जे ई स्वचलित सम्बद्ध फाइल एक्सटेंशन क' संपादन कए देत."

#: autobookmarker/autobookmarker.cpp:367
msgid "Select Mime Types"
msgstr "माइम प्रकार चुनू"

#: autobookmarker/autobookmarker.cpp:384
msgid "&Patterns"
msgstr "प्रारूप (&P)"

#: autobookmarker/autobookmarker.cpp:387
msgid "Pattern"
msgstr "प्रारूप"

#: autobookmarker/autobookmarker.cpp:388
msgid "Mime Types"
msgstr "माइम प्रकार"

#: autobookmarker/autobookmarker.cpp:389
msgid "File Masks"
msgstr "फाइल मास्क्स"

#: autobookmarker/autobookmarker.cpp:393
msgid ""
"<p>This list shows your configured autobookmark entities. When a document is "
"opened, each entity is used in the following way:<p><ol><li>The entity is "
"dismissed, if a mime and/or filename mask is defined, and neither matches "
"the document.</li><li>Otherwise each line of the document is tried against "
"the pattern, and a bookmark is set on matching lines.</li></ol><p>Use the "
"buttons below to manage your collection of entities.</p>"
msgstr ""

#: autobookmarker/autobookmarker.cpp:404
msgid "&New..."
msgstr "नवीन... (&N)"

#: autobookmarker/autobookmarker.cpp:407
msgid "Press this button to create a new autobookmark entity."
msgstr "नवीन स्वचालित-पसंद एंटिटी बनाबै क' लेल एहि बटन केँ दबाबू."

#: autobookmarker/autobookmarker.cpp:409
msgid "&Delete"
msgstr "मेटाबू (&D)"

#: autobookmarker/autobookmarker.cpp:412
msgid "Press this button to delete the currently selected entity."
msgstr "मोजुदा चुनल गेल एंटिटी मेटाबै क' लेल एहि बटन केँ दबाबू."

#: autobookmarker/autobookmarker.cpp:414
msgid "&Edit..."
msgstr "संपादित करु (&E)..."

#: autobookmarker/autobookmarker.cpp:417
msgid "Press this button to edit the currently selected entity."
msgstr "मोजुदा चुनल गेल एंटिटी क' संपादन करब क' लेल एहि बटन केँ दबाबू."


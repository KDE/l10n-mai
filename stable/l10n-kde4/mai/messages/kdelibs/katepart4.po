msgstr "गुण"

#: mode/katemodeconfigpage.cpp:266
msgid ""
"Select the MimeTypes you want for this file type.\n"
"Please note that this will automatically edit the associated file extensions "
"as well."
msgstr ""
"माइम प्रकार चुनू जे अहाँ एहि फाइल प्रकार क' लेल चाहैत छी.\n"
"कृप्या टीप लिअ' जे ई अपनेसँ सम्बद्ध फाइलक विस्तारकेँ संपादनो कए देत."

#: mode/katemodeconfigpage.cpp:268
msgid "Select Mime Types"
msgstr "माइम प्रकार चुनू"

#: view/kateviewhelpers.cpp:365
msgid "Available Commands"
msgstr "मोजुद कमांडसभ"

#: view/kateviewhelpers.cpp:367
msgid ""
"<p>For help on individual commands, do <code>'help &lt;command&gt;'</code></"
"p>"
msgstr ""

#: view/kateviewhelpers.cpp:378
#, kde-format

#: kde-menu.cpp:93
#, kde-format
msgid "Menu item '%1' could not be highlighted."
msgstr "मेनू मद केँ '%1' उभारल नहि जाए सकत."

#: kde-menu.cpp:106
#, kde-format
msgid ""
"KDE Menu query tool.\n"
"This tool can be used to find in which menu a specific application is "
"shown.\n"
"The --highlight option can be used to visually indicate to the user where\n"
"in the KDE menu a specific application is located."
msgstr ""

#: kde-menu.cpp:111
#, kde-format
msgid "kde-menu"
msgstr "केडीई-मेनू"

#: kde-menu.cpp:113
#, kde-format
msgid "(c) 2003 Waldo Bastian"
msgstr "(c) 2003 वाल्दो बास्तियान"

#: kde-menu.cpp:114
#, kde-format
msgid "Waldo Bastian"
msgstr "वाल्दो बास्तियान"

#: kde-menu.cpp:114
#, kde-format
msgid "Author"
msgstr "लेखक"

#: kde-menu.cpp:119
#, kde-format
msgid "Output data in UTF-8 instead of local encoding"
msgstr "आउटपुट डाटा यूटीएफ-8 मे स्थानीय एनकोडिंगक बदला"

#: kde-menu.cpp:120
#, kde-format
msgid ""
"Print menu-id of the menu that contains\n"
"the application"
msgstr ""
"मेनू क' मेन्यू-आइडी छापू जकरामे जे\n"
"अनुप्रयोग अछि."

#: kde-menu.cpp:121
#, kde-format
msgid ""
"Print menu name (caption) of the menu that\n"
"contains the application"
msgstr ""
"ओ मेनू (कैप्शन) क' नाम छापू\n"
"जकरामे अनुप्रयोग अछि."

#: kde-menu.cpp:122
#, kde-format
msgid "Highlight the entry in the menu"
msgstr "मेनू मे प्रविष्टि केँ उभारू"

#: kde-menu.cpp:123
#, kde-format
msgid "Do not check if sycoca database is up to date"
msgstr "सिकोका डाटाबेस अद्यतन अछि तँ नहि जाँचू."

#: kde-menu.cpp:124
#, kde-format
msgid "The id of the menu entry to locate"
msgstr "मेनू प्रविष्टि केँ लोकेट करबाक आइडी."

#: kde-menu.cpp:133
#, kde-format
msgid "You must specify an application-id such as 'kde4-konsole.desktop'"
msgstr "अहाँकेँ एकटा अनुप्रयोग आई-डी उल्लेखित करै पड़त जहिना- 'kde4-konsole.desktop'"

#: kde-menu.cpp:142
#, kde-format
msgid ""
"You must specify at least one of --print-menu-id, --print-menu-name or --"
"highlight"
msgstr ""
"अहाँकेँ एकरामे सँ कोनो एकटा केँ उल्लेखित करै पड़त --print-menu-id, --print-menu-name or "
"--highlight"

#: kde-menu.cpp:164
#, kde-format
msgid "No menu item '%1'."
msgstr "कोनो मेनू मद नहि '%1'."

#: kde-menu.cpp:168
#, kde-format
msgid "Menu item '%1' not found in menu."
msgstr "मेनू आइटम  '%1' मेनू मे नहि भेटल."
